<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Send suspicious notifications to the SunoSafe backend. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Show SunoSafe's own warning (asked at runtime on Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Find out whether Google's speech engine is installed (it has Hindi voices). -->
    <queries>
        <package android:name="com.google.android.tts" />
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_shield"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/SunoTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Pairing link opened from the user's own SunoSafe web app: sunosafe://pair?... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sunosafe" android:host="pair" />
            </intent-filter>
        </activity>

        <!--
            The notification listener. Android only starts it after the user turns on
            "Notification access" for SunoSafe in system settings; the permission below
            means only the Android system itself can bind to it.
        -->
        <service
            android:name=".SunoNotificationListener"
            android:exported="true"
            android:label="@string/listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            Caller checking. Only used after the user makes SunoSafe the phone's
            "Caller ID & spam" app; only the system telecom service can bind to it.
        -->
        <service
            android:name=".SunoCallScreener"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>
    </application>
</manifest>
