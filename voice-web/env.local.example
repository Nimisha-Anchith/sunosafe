# Agora credentials
# Required: found in Agora Console → your project → "App ID"
NEXT_PUBLIC_AGORA_APP_ID=

# Required: found in Agora Console → your project → "App Certificate"
# Server-side only. Never expose this in client code.
NEXT_AGORA_APP_CERTIFICATE=

# Murf Falcon TTS (BYOK). Get the key from https://murf.ai/api/dashboard
# When set, the agent speaks with Murf Falcon instead of the default MiniMax voice.
NEXT_MURF_API_KEY=
# Optional overrides (defaults: hi-IN-jaya / en-IN)
NEXT_MURF_VOICE_ID=
NEXT_MURF_LOCALE=

# SunoSafe custom LLM (optional). Public HTTPS address of the SunoSafe voice gateway
# and its gateway token. When both are set, the agent's brain is SunoSafe.
NEXT_SUNOSAFE_LLM_URL=
NEXT_SUNOSAFE_LLM_KEY=

# SunoSafe app lock (both required, or the app refuses to open).
# PIN: at least 6 digits. Secret: at least 32 random characters.
SUNOSAFE_APP_PIN=
SUNOSAFE_SESSION_SECRET=
# Private SunoSafe backend, reached only from this server.
SUNOSAFE_BACKEND_URL=http://127.0.0.1:8000

# Android companion pairing: same value as DEVICE_TOKEN in the backend's .env,
# and the path of the built APK offered for download inside the locked app.
SUNOSAFE_DEVICE_TOKEN=
SUNOSAFE_APK_PATH=

# Call shield: the SunoSafe phone number (Vobiz) that suspicious calls are forwarded to. Public, shown in the app.
NEXT_PUBLIC_SUNOSAFE_SHIELD_NUMBER=

# Hosting (Vercel): the backend on Render. SUNOSAFE_BACKEND_TOKEN = the backend's API_TOKEN.
# NEXT_SUNOSAFE_LLM_URL then is https://<render-host>/gw/llm/chat/completions
SUNOSAFE_BACKEND_URL=
SUNOSAFE_BACKEND_TOKEN=
# Download link of the Android companion (used instead of SUNOSAFE_APK_PATH when hosted)
SUNOSAFE_APK_URL=
