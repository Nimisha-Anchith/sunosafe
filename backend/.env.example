# Copy this file to backend/.env and fill in values. backend/.env is git-ignored.
# Never paste keys into chat, source code or the Android app.

# Google Safe Browsing (Lookup API v4). Optional: without it, reputation = "not_configured".
SAFE_BROWSING_API_KEY=

# DNS resolvers used for investigations (comma separated). Leave empty to use the system resolver.
DNS_SERVERS=1.1.1.1,8.8.8.8

# Per-request network timeout in seconds.
HTTP_TIMEOUT_SECONDS=5
