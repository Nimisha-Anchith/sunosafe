# Copy this file to backend/.env and fill in values. backend/.env is git-ignored.
# Never paste keys into chat, source code or the Android app.

# Google Safe Browsing (Lookup API v4). Optional: without it, reputation = "not_configured".
SAFE_BROWSING_API_KEY=

# DNS resolvers used for investigations (comma separated). Leave empty to use the system resolver.
DNS_SERVERS=1.1.1.1,8.8.8.8

# Per-request network timeout in seconds.
HTTP_TIMEOUT_SECONDS=5

# Access token for the API and Guardian Web View. Empty = only this computer (localhost) may connect.
# Set a long random value before exposing the backend through a tunnel or server.
API_TOKEN=

# SQLite database file (default: backend/data/sunosafe.db, git-ignored).
SUNOSAFE_DB=

# LLM "brain" for the voice agent (OpenAI-compatible chat completions).
# Default is Gemini: create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (fast hosted open models): create a key at https://console.groq.com/keys
# When set, Groq is used instead of Gemini.
GROQ_API_KEY=
# Any other OpenAI-compatible provider (Ollama, ...):
# LLM_API_KEY=
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODELS=model-one,model-two

# Token for the public voice gateway (port 8001) only. Agora sends it as the custom LLM api key.
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_TOKEN=

# Token for the paired Android companion (reports notifications to /device/notifications).
# Different from GATEWAY_TOKEN. Generate the same way.
DEVICE_TOKEN=
